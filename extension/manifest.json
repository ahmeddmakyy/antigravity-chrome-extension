{
  "manifest_version": 3,
  "name": "MyChrome",
  "version": "5.1.0",
  "description": "Unofficial Antigravity Chrome extension. Chat with your Google Antigravity agent from a side panel in your signed-in tabs.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "sidePanel",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MyChrome: open the side panel on this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "locales/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
